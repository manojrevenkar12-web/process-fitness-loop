<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="definitions_as_documented" targetNamespace="https://github.com/manojrevenkar12-web/process-fitness-loop">
  <bpmn:process id="payment-investigation" name="Payment investigation (as documented)" isExecutable="true">
    <bpmn:documentation>The process as the operations procedure (SOP v4.2) describes it. Generated from the procedure document before any history was read.</bpmn:documentation>
    <bpmn:startEvent id="inquiry_received" name="Inquiry received">
      <bpmn:outgoing>f_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="register_inquiry" name="Register inquiry">
      <bpmn:documentation>Read the inbound message, key UETR, amount and inquiry type into the case tool.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="payments-ops" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="lookup_payment" name="Look up payment in hub">
      <bpmn:documentation>Find the original payment in the payments hub screens by UETR or reference.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="payments-ops" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_type" name="Inquiry type?" default="f_query" />
    <bpmn:userTask id="check_funds" name="Check funds can be returned">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="payments-ops" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_amount" name="Above four-eyes limit?" default="f_small" />
    <bpmn:userTask id="second_approval" name="Second approval">
      <bpmn:documentation>Four-eyes control: a team lead approves every recall above 10,000.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="team-leads" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_approved_merge" />
    <bpmn:userTask id="send_recall" name="Send recall">
      <bpmn:documentation>Key the recall (camt.056) into the payments hub.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="payments-ops" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="trace_payment" name="Trace payment in gpi tracker">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="payments-ops" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="notify_customer" name="Tell customer the status">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="payments-ops" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="answer_query" name="Answer query">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="payments-ops" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_done_merge" />
    <bpmn:userTask id="close_case" name="Close case">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="payments-ops" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="resolved" name="Inquiry resolved" />

    <bpmn:sequenceFlow id="f_start" sourceRef="inquiry_received" targetRef="register_inquiry" />
    <bpmn:sequenceFlow id="f_registered" sourceRef="register_inquiry" targetRef="lookup_payment" />
    <bpmn:sequenceFlow id="f_looked_up" sourceRef="lookup_payment" targetRef="gw_type" />
    <bpmn:sequenceFlow id="f_recall" name="recall" sourceRef="gw_type" targetRef="check_funds">
      <bpmn:conditionExpression>=inquiryType = "RECALL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_non_receipt" name="non-receipt" sourceRef="gw_type" targetRef="trace_payment">
      <bpmn:conditionExpression>=inquiryType = "NON_RECEIPT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_query" name="query" sourceRef="gw_type" targetRef="answer_query" />
    <bpmn:sequenceFlow id="f_funds_checked" sourceRef="check_funds" targetRef="gw_amount" />
    <bpmn:sequenceFlow id="f_large" name="above 10,000" sourceRef="gw_amount" targetRef="second_approval">
      <bpmn:conditionExpression>=amount &gt; 10000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_small" sourceRef="gw_amount" targetRef="gw_approved_merge" />
    <bpmn:sequenceFlow id="f_approved" sourceRef="second_approval" targetRef="gw_approved_merge" />
    <bpmn:sequenceFlow id="f_to_send" sourceRef="gw_approved_merge" targetRef="send_recall" />
    <bpmn:sequenceFlow id="f_sent" sourceRef="send_recall" targetRef="gw_done_merge" />
    <bpmn:sequenceFlow id="f_traced" sourceRef="trace_payment" targetRef="notify_customer" />
    <bpmn:sequenceFlow id="f_notified" sourceRef="notify_customer" targetRef="gw_done_merge" />
    <bpmn:sequenceFlow id="f_answered" sourceRef="answer_query" targetRef="gw_done_merge" />
    <bpmn:sequenceFlow id="f_to_close" sourceRef="gw_done_merge" targetRef="close_case" />
    <bpmn:sequenceFlow id="f_closed" sourceRef="close_case" targetRef="resolved" />
  </bpmn:process>
</bpmn:definitions>
